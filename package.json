{
  "name": "aram-group-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Tracks ARAM matches played with a fixed group of friends via Riot's Match-V5 API and exports every stat to Excel.",
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "watch": "tsx scripts/watch.ts",
    "sync": "tsx scripts/sync-once.ts",
    "export": "tsx scripts/export-once.ts",
    "desktop": "electron .",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "main": "desktop/main.cjs",
  "author": "ARAM Group Tracker"
}
