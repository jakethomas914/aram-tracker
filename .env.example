# Copy to .env.local and fill in your key. Without RIOT_API_KEY the app runs on
# generated demo matches so you can click around before wiring up the real API.

# Riot developer key from https://developer.riotgames.com (RGAPI-...).
# Development keys expire every 24 hours.
RIOT_API_KEY=

# Regional routing cluster for Account-V1 and Match-V5.
# americas | europe | asia | sea — a platform id such as na1 or euw1 also works.
RIOT_REGION=americas

# Riot IDs to seed the roster with on first run, comma separated.
# ARAM_ROSTER=PoroSnaxx#NA1,BaronSteal#NA1

# A match is stored only when at least this many roster members are in it.
ARAM_MIN_GROUP_SIZE=2

# How far back to look and how many match IDs to request per friend (Riot caps at 100).
ARAM_LOOKBACK_DAYS=90
ARAM_MATCHES_PER_PLAYER=40

# Match details fetched per sync pass. Rate limits make a large first backfill
# slow, so each pass stays short and the next one picks up where it left off.
ARAM_MAX_MATCHES_PER_SYNC=30

# Fetch the match timeline to capture ability order (one extra request per match).
ARAM_FETCH_TIMELINES=true

# How often `npm run watch` polls for new games.
ARAM_WATCH_INTERVAL_SECONDS=300

# Rewrite exports/aram-stats.xlsx whenever new matches are found.
ARAM_AUTO_WRITE_WORKBOOK=true

# Force demo data even when a key is present.
# ARAM_DEMO_MODE=false

# Where the JSON store and the generated workbook live.
# DATA_DIR=./data
# EXPORT_DIR=./exports
